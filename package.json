{
  "name": "memory-cards-mcp-app",
  "version": "0.1.0",
  "description": "Capture meaningful moments from AI conversations as beautiful collectible cards",
  "type": "module",
  "workspaces": ["ui"],
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "cd ui && bun run dev",
    "build": "cd ui && bun run build",
    "deploy": "cd ui && bun run build && cd .. && wrangler deploy",
    "db:migrate": "wrangler d1 execute memory-cards-db --file=./src/db/migrations/001_initial.sql",
    "db:migrate:local": "wrangler d1 execute memory-cards-db --local --file=./src/db/migrations/001_initial.sql",
    "typecheck": "tsc --noEmit && cd ui && bun run typecheck"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.25.0"
  }
}
